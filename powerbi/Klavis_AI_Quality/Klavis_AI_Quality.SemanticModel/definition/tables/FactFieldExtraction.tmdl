table FactFieldExtraction
	lineageTag: 24656cc5-091e-543b-bbef-c54783d44740

	/// Fields compared with the ground truth.
	measure 'Scored Fields' = SUM ( FactFieldExtraction[is_scored] )
		formatString: #,0
		displayFolder: 2 Field quality
		lineageTag: da6153c7-e862-5b11-b39a-90ff0fbce857

	measure 'Correct Fields' = SUM ( FactFieldExtraction[is_correct] )
		formatString: #,0
		displayFolder: 2 Field quality
		lineageTag: 1ddd10cc-a9e3-5b00-b049-b37f97edb6bf

	/// Correct fields / scored fields (null = null counts as correct).
	measure 'Field Accuracy %' = DIVIDE ( [Correct Fields], [Scored Fields] )
		formatString: 0.0%
		displayFolder: 2 Field quality
		lineageTag: 9ee4ed74-62af-5f14-8b07-4ac011a591a1

	/// Share of the fields present in the document that the extraction found.
	measure 'Completeness %' = DIVIDE ( SUM ( FactFieldExtraction[found_when_present] ), SUM ( FactFieldExtraction[expected_present] ) )
		formatString: 0.0%
		displayFolder: 2 Field quality
		lineageTag: 93c9fac7-3462-508b-be8c-6a4393237080

	/// Fields reported missing (absent from the document or not found).
	measure 'Missing Fields' = SUM ( FactFieldExtraction[is_missing] )
		formatString: #,0
		displayFolder: 2 Field quality
		lineageTag: fb81ecb2-09ea-5237-805b-56cb46a66150

	measure 'Missing Rate %' = DIVIDE ( [Missing Fields], COUNTROWS ( FactFieldExtraction ) )
		formatString: 0.0%
		displayFolder: 2 Field quality
		lineageTag: 446f9a1b-00cf-5611-b666-a694fbbdcc65

	/// Fields with contradictory values in the document.
	measure 'Conflicting Fields' = SUM ( FactFieldExtraction[has_conflict] )
		formatString: #,0
		displayFolder: 2 Field quality
		lineageTag: e8d36ba3-6fa9-5921-a71f-cd485843fdda

	/// Average confidence of the fields that were found.
	measure 'Avg Field Confidence' = CALCULATE ( AVERAGE ( FactFieldExtraction[confidence] ), FactFieldExtraction[is_missing] = 0 )
		formatString: 0.00
		displayFolder: 2 Field quality
		lineageTag: 4eeba76d-87ca-515b-ba14-a4279ce7f4ba

	/// Fields changed by the reviewer before the case was created.
	measure 'Manual Corrections' = SUM ( FactFieldExtraction[was_corrected] )
		formatString: #,0
		displayFolder: 2 Field quality
		lineageTag: 5a550191-db94-5eb9-81ec-3206c8d1e7da

	measure 'Manual Correction Rate %' = DIVIDE ( [Manual Corrections], SUM ( FactFieldExtraction[is_reviewed] ) )
		formatString: 0.0%
		displayFolder: 2 Field quality
		lineageTag: 7f1b6fd4-f097-5940-b4cc-e4c2c10c6b5b

