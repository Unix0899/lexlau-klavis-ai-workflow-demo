table FactAIRuns
	lineageTag: f52bcdae-ea85-5635-866e-75cfa8959a1b

	/// All AI runs: extraction, category suggestion, summarisation, assistant.
	measure 'Total AI Runs' = COUNTROWS ( FactAIRuns )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: 5c852bd0-a098-5a57-a36a-f6678eb1cd84

	measure 'Successful AI Runs' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[status] = "success" )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: 57d5da34-fa63-59ab-8ac1-deb80571e89d

	/// Runs that ended in a structured error.
	measure 'Failed AI Runs' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[status] = "error" )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: 919a7516-db84-5b3c-a092-0219a991b899

	/// Successful / all AI runs in context.
	measure 'AI Success Rate %' = DIVIDE ( [Successful AI Runs], [Total AI Runs] )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: ca02a3d9-f7d9-5189-87f9-08515ebb8359

	measure 'Extraction Runs' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[task] = "extraction" )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: c3856d0c-d7ab-586c-9e0f-a5faaf5be8f1

	measure 'Successful Extractions' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[task] = "extraction", FactAIRuns[status] = "success" )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: e9909da8-d663-53e6-a5c5-2345d6d42040

	/// Document success rate: extraction runs processed without error (same as the app KPI).
	measure 'Extraction Success Rate %' = DIVIDE ( [Successful Extractions], [Extraction Runs] )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: d83dd1d1-21a5-527f-ac80-73aec63fcce3

	/// Mean overall confidence of successful extractions (demonstration metric).
	measure 'Average Confidence' = CALCULATE ( AVERAGE ( FactAIRuns[confidence_score] ), FactAIRuns[task] = "extraction", FactAIRuns[status] = "success" )
		formatString: 0.00
		displayFolder: 1 AI runs
		lineageTag: 14ec4091-06a7-534f-b300-44dc0ff7a5b9

	/// Milliseconds. Latency of extraction runs. In the synthetic dataset it comes from a latency model (flagged per run).
	measure 'Average Processing Time' = CALCULATE ( AVERAGE ( FactAIRuns[processing_ms] ), FactAIRuns[task] = "extraction" )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: c229c864-a148-5a0b-9840-6cb27913fdfc

	/// Extraction runs where the primary provider failed and the fallback was invoked.
	measure 'Fallback Runs' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[task] = "extraction", FactAIRuns[fallback_used] = 1 )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: ef6b3bf4-1b50-5ba5-a728-912c5f3c7b55

	measure 'Fallback Rate %' = DIVIDE ( [Fallback Runs], [Extraction Runs] )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: 2d3f0e7b-c554-5afb-9082-a809fc779097

	/// Extraction runs ended in error.
	measure 'Error Rate %' = DIVIDE ( CALCULATE ( [Failed AI Runs], FactAIRuns[task] = "extraction" ), [Extraction Runs] )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: d2805e87-4c29-52da-9c0f-d64c6a6817bb

	/// Successful extractions flagged Needs Review or Missing Information.
	measure 'Human Review Cases' = CALCULATE ( COUNTROWS ( FactAIRuns ), FactAIRuns[needs_review] = 1 )
		formatString: #,0
		displayFolder: 1 AI runs
		lineageTag: 3164beb3-81e5-5322-8497-f7e8bbaf6ea2

	measure 'Human Review Rate %' = DIVIDE ( [Human Review Cases], [Successful Extractions] )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: 7927409a-e9ca-5837-b70e-8087a0eef5c0

	measure 'PDF Success Rate %' = CALCULATE ( [Extraction Success Rate %], DimDocumentType[file_family] = "PDF" )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: e74682cb-51bc-5204-a43b-5ce935f14a85

	measure 'DOCX Success Rate %' = CALCULATE ( [Extraction Success Rate %], DimDocumentType[file_family] = "DOCX" )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: ac8a1917-0268-5823-93d7-493427fe3a35

	measure 'Image Success Rate %' = CALCULATE ( [Extraction Success Rate %], DimDocumentType[file_family] = "Image" )
		formatString: 0.0%
		displayFolder: 1 AI runs
		lineageTag: 69cb4aa1-7fe5-5dd0-a507-db1abcffcd57

