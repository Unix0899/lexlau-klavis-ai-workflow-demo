	partition FactAIRuns = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactAIRuns.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"ai_run_id", Int64.Type}, {"date_key", Int64.Type}, {"document_type_id", Int64.Type}, {"provider_id", Int64.Type}, {"task", type text}, {"document_role", type text}, {"status", type text}, {"is_success", Int64.Type}, {"is_error", Int64.Type}, {"error_stage", type text}, {"error_code", type text}, {"fallback_used", Int64.Type}, {"fallback_reason", type text}, {"confidence_score", type number}, {"confidence_band", type text}, {"intake_status", type text}, {"needs_review", Int64.Type}, {"missing_count", Int64.Type}, {"conflict_count", Int64.Type}, {"processing_ms", type number}, {"latency_is_simulated", Int64.Type}, {"is_retry", Int64.Type}, {"case_id", Int64.Type}}, "en-US")
				in
				    Typed

