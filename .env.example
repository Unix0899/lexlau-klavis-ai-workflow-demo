# Klavis AI Workflow Demo - optional settings.
# The demo runs WITHOUT any key: the default provider is the local MockAIProvider.
# Copy to .env only on your own machine; never commit a real .env (it is git-ignored).

# Provider chain: mock | mock-fallback | openai | anthropic
LEXLAU_PRIMARY_PROVIDER=mock
LEXLAU_FALLBACK_PROVIDER=mock-fallback
LEXLAU_PROVIDER_TIMEOUT_S=20

# Optional external providers - leave empty. Only use them with the synthetic documents.
OPENAI_API_KEY=
LEXLAU_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LEXLAU_ANTHROPIC_MODEL=claude-sonnet-5

# App
LEXLAU_HOST=127.0.0.1
LEXLAU_PORT=8765
LEXLAU_MAX_UPLOAD_BYTES=5242880
LEXLAU_REVIEW_THRESHOLD=0.80

# Replay synthetic bugs (comma separated, empty = none):
# docx_routing, category_substring, duplicate_no_idempotency, fallback_mislabel, missing_as_zero
LEXLAU_BUG_REPLAY=
