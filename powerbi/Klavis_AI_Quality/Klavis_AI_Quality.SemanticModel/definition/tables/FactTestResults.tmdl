	column duration_ms
		dataType: double
		lineageTag: dcdc9625-1ee2-5061-80bd-849bf29aa062
		summarizeBy: sum
		sourceColumn: duration_ms

	partition FactTestResults = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactTestResults.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"result_id", Int64.Type}, {"test_run_id", Int64.Type}, {"run_label", type text}, {"run_description", type text}, {"run_order", Int64.Type}, {"date_key", Int64.Type}, {"scenario_code", type text}, {"status", type text}, {"is_pass", Int64.Type}, {"is_fail", Int64.Type}, {"is_regression", Int64.Type}, {"failure_category", type text}, {"bug_replay", type text}, {"duration_ms", type number}}, "en-US")
				in
				    Typed

