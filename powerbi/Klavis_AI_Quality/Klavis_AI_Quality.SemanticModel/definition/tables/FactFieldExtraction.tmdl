	partition FactFieldExtraction = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactFieldExtraction.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"field_id", Int64.Type}, {"ai_run_id", Int64.Type}, {"date_key", Int64.Type}, {"document_type_id", Int64.Type}, {"provider_id", Int64.Type}, {"field_name", type text}, {"field_label", type text}, {"confidence", type number}, {"is_missing", Int64.Type}, {"has_conflict", Int64.Type}, {"expected_present", Int64.Type}, {"found_when_present", Int64.Type}, {"is_scored", Int64.Type}, {"is_correct", Int64.Type}, {"is_reviewed", Int64.Type}, {"was_corrected", Int64.Type}}, "en-US")
				in
				    Typed

